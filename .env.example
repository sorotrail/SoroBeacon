# Stellar RPC endpoint (JSON-RPC 2.0). Default is testnet; point at a
# mainnet RPC for production.
RPC_URL=https://soroban-testnet.stellar.org

# Optional ordered list of RPC endpoints to fail over between, highest
# priority first, comma-separated. Takes priority over RPC_URL when set, so
# set one or the other, never both. A transport error, 429 or 5xx answer
# quarantines that endpoint with an exponential backoff (capped at 5m) and
# retries the same call on the next one; a 4xx or JSON-RPC error does not,
# because it would fail identically everywhere. At startup every endpoint is
# checked to be on the configured network and a mismatch is fatal, because
# failover would otherwise mix two chains' events into the alert stream.
# RPC_URLS=https://my-paid-rpc.example,https://soroban-testnet.stellar.org

# Postgres connection string (required). Validated at load: postgres or
# postgresql URL. Errors name the variable and never echo the password.
# Database connection string (required). The scheme selects the backend and
# is validated at load; errors name the variable and never echo a password.
#
#   postgres:// / postgresql://  the default, a Postgres server (pgx pool).
#   sqlite://<path>              a single SQLite file, no server at all — for
#                                one contract on a small VPS or a Raspberry Pi.
#                                WAL mode is enabled. The parent directory is
#                                created if missing.
#
# A SQLite database serialises writes: exactly one write happens at a time.
# That is fine for a single instance, but it is not a fit for many writers or
# for several SoroBeacon instances sharing one file — use Postgres for those.
DATABASE_URL=postgres://sorobeacon:sorobeacon@localhost:5432/sorobeacon?sslmode=disable
# DATABASE_URL=sqlite:///var/lib/sorobeacon/sorobeacon.db

# Optional pgx pool tuning (Postgres only). Unset or 0 keeps the driver
# default, so a small VPS can lower MaxConns without a code change and a busy
# instance behind PgBouncer can raise it. Max must not be below min when both
# are set; negatives are rejected at startup. Setting any of these with a
# sqlite DATABASE_URL fails at startup, so a setting that cannot take effect
# is never silently ignored.
# DATABASE_MAX_CONNS=4
# DATABASE_MIN_CONNS=0
# DATABASE_MAX_CONN_LIFETIME=1h
# DATABASE_MAX_CONN_IDLE_TIME=30m

# Route the read-only dashboard queries — the monitor list, the alert search,
# the headline stats and the alert-counts-by-day chart — to a Postgres read
# replica, leaving the primary's pool for the poller's writes. Unset (the
# default) keeps every read on the primary. Must be a postgres:// URL that
# differs from DATABASE_URL; both are checked at startup, and a replica that
# cannot be reached at boot is a startup error. A replica that goes away later
# degrades to the primary and shows up in
# sorobeacon_store_replica_fallbacks_total. Has no effect with a sqlite
# DATABASE_URL and is rejected there rather than silently ignored.
# REPLICA_DATABASE_URL=postgres://sorobeacon:sorobeacon@replica-host:5432/sorobeacon?sslmode=disable

# Encrypt channel config (webhook URLs, bot tokens, SMTP credentials) at
# rest. Base64-encoded AES-GCM key that must decode to 16, 24 or 32 bytes
# (32 recommended); validated at startup. When set, channels.config is
# encrypted before it is written and decrypted on read. Existing plaintext
# rows keep working and are re-encrypted on their next update. Unset
# (default) stores plaintext and logs one warning at startup.
# Generate with: openssl rand -base64 32
# CONFIG_ENCRYPTION_KEY=

# --- External secrets --------------------------------------------------------
# Resolve ${secret:<provider>:<path>[#<key>]} references in channel config
# against a system you already audit and rotate, so webhook URLs and tokens
# do not have to live only in the database. Unset (default) disables external
# secrets and treats references as literals, so an upgrade changes nothing.
#
#   env     resolve ${secret:env:SLACK_WEBHOOK_URL} from the process env.
#   vault   resolve ${secret:vault:kv/data/sorobeacon#slack_token} from
#           HashiCorp Vault (KV v1 or v2). VAULT_ADDR is required.
#
# Resolved values are never written back to the database, logged or returned
# by the API; a resolution failure names the reference, never the value, and
# fails the send. See docs/channels/secrets.md.
# SECRETS_PROVIDER=env
# How long a resolved secret is reused so a burst of alerts does not hit the
# provider once per alert. Default 5m; 0s disables caching. The cache is
# dropped whenever a channel is created, updated or deleted.
# SECRETS_CACHE_TTL=5m
# VAULT_ADDR=https://vault.example:8200
# VAULT_TOKEN=
# VAULT_NAMESPACE=

# How often to poll getEvents (minimum 1s).
POLL_INTERVAL=5s

# API + dashboard listen address (host:port; empty host means all interfaces).
# How long since a monitor's last_matched_at before the dashboard marks it
# silent. The stored time is the matching event's ledger close time.
# MONITOR_SILENT_AFTER=24h

# API + dashboard listen address.
HTTP_ADDR=:8080

# Maximum request body size for API write endpoints (POST/PATCH/PUT), in
# bytes. Default 1 MiB is large enough for nested rule params and small
# enough to bound a single oversized write. GET/HEAD/OPTIONS are not limited.
# HTTP_MAX_BODY_BYTES=1048576

# debug | info | warn | error
LOG_LEVEL=info

# Ledger lag at which /readyz fails. Unset or 0 disables the check so
# existing probes cannot start failing without opting in.
# READYZ_LAG_THRESHOLD=0
# How long to keep alerts (and cascaded delivery_attempts). Unset keeps
# history forever. Examples: 90d, 24h. Deletes run in batches of 1000. On
# Postgres, alerts are partitioned by month and retention drops whole expired
# partitions, falling back to batched deletes for the current partition.
# ALERT_RETENTION=90d

# Copy alerts to object storage before retention deletes them. Unset
# (default) leaves retention as a plain delete. A local directory path,
# file://, dir://, or s3://bucket/prefix are accepted. For s3://, set
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY; ?region= and ?endpoint=
# override the region and the endpoint (for MinIO or a test server). A failed
# archive blocks the delete, so nothing is dropped un-archived. Requires
# ALERT_RETENTION.
# ARCHIVE_URL=/var/lib/sorobeacon/archive
# ARCHIVE_URL=s3://my-bucket/sorobeacon?region=us-east-1

# Chain-reorg detection. The poller keeps the hash of the last
# REORG_TRACKING_WINDOW ledgers and re-reads them each cycle; a ledger whose
# hash changes marks the alerts derived from the orphaned range as retracted
# (they are kept and flagged, never deleted). 0 disables detection. Default
# 128 ledgers, roughly ten minutes on Stellar.
# REORG_TRACKING_WINDOW=128

# Hold alerts until the event is this many ledgers behind the tip, trading
# latency for fewer retractions. 0 (default) alerts immediately, which is the
# behaviour before the setting existed.
# REORG_CONFIRMATION_DEPTH=0

# --- Network -------------------------------------------------------------
# Which Stellar network to monitor. A network's passphrase is its identity:
# SoroBeacon verifies at startup that the RPC endpoint belongs to the
# configured network and refuses to start on a mismatch, so a mainnet
# endpoint behind testnet configuration fails fast instead of silently
# evaluating rules against the wrong chain.
#   testnet    (default) SDF public testnet
#   mainnet    SDF public mainnet
#   futurenet  SDF futurenet
#   custom     private network: RPC_URL and NETWORK_PASSPHRASE required
NETWORK=testnet
# Override the RPC endpoint for any network (e.g. a provider URL for
# mainnet, or a local quickstart node).
# RPC_URL=https://soroban-testnet.stellar.org
# Override the passphrase (e.g. a local standalone quickstart network).
# NETWORK_PASSPHRASE=Standalone Network ; February 7th 1974 at 8:37:19 PM

# --- Observability --------------------------------------------------------
# Prometheus metrics are served on /metrics (no configuration needed).

# OpenTelemetry tracing (OTLP/HTTP). Unset (default) = tracing entirely
# off: no exporter, no overhead. When set, one trace per poll cycle spans
# RPC fetch -> rule evaluation -> alert write -> channel deliveries, and
# each span carries the request id so logs and traces join. Channel config
# (webhook URLs, tokens) never enters a span.
# OTLP_ENDPOINT=http://localhost:4318
# OTLP_SERVICE_NAME=sorobeacon
# OTLP_SAMPLE_RATE=1

# --- Event source --------------------------------------------------------
# Where events come from.
#   rpc        (default) poll a Stellar RPC node directly (standalone)
#   sorotrail  read from a SoroTrail indexer's HTTP API (upstream)
# Upstream mode monitors through an indexer that stores events durably,
# past the RPC's ~1-7 day retention window, and lets several SoroBeacon
# instances share one indexer.
SOURCE_MODE=rpc
# Base URL of a SoroTrail indexer. Required when SOURCE_MODE=sorotrail.
# SOROTRAIL_URL=http://localhost:8080

# --- Authentication ----------------------------------------------------------
# Static bearer token(s) for /api/v1, and the credential the dashboard's
# sign-in page accepts. Comma-separated, so a token can be rotated without
# downtime (add the new one, roll clients over, drop the old one). Clients
# send `Authorization: Bearer <token>`. No leading/trailing whitespace, and
# no commas inside a token.
#
# Unset (default) leaves the API AND the dashboard open, which is how the
# docker-compose quickstart works, and logs one warning at startup. Set it on
# anything reachable beyond a trusted network: an open API can create,
# rewrite and delete monitors and channels.
# Generate with: openssl rand -hex 32
# API_TOKEN=

# --- CORS --------------------------------------------------------------------
# Comma-separated allow-list of browser Origins that may call the API
# cross-origin. Empty (default) disables CORS — the dashboard is same-origin.
# Think hard before allowing a third-party origin: even authenticated, a
# browser origin you allow can act with whatever credential it holds.
# CORS_ALLOWED_ORIGINS=https://ops.example

# --- API rate limiting -------------------------------------------------------
# Per-client token bucket on /api/v1. Unset / 0 leaves the limiter off so
# existing probes and scripts are unaffected. Health, livez and readyz are
# always exempt. Client identity is RemoteAddr unless TRUST_FORWARDED is on
# (only enable that behind a proxy that overwrites X-Forwarded-For).
# RATE_LIMIT_RPS=10
# RATE_LIMIT_BURST=20
# RATE_LIMIT_TRUST_FORWARDED=false
