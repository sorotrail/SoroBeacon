# Stellar RPC endpoint (JSON-RPC 2.0). Default is testnet; point at a
# mainnet RPC for production.
RPC_URL=https://soroban-testnet.stellar.org

# Postgres connection string (required).
DATABASE_URL=postgres://sorobeacon:sorobeacon@localhost:5432/sorobeacon?sslmode=disable

# Optional pgx pool tuning. Unset or 0 keeps the driver default, so a
# small VPS can lower MaxConns without a code change and a busy
# instance behind PgBouncer can raise it. Max must not be below min
# when both are set; negatives are rejected at startup.
# DATABASE_MAX_CONNS=4
# DATABASE_MIN_CONNS=0
# DATABASE_MAX_CONN_LIFETIME=1h
# DATABASE_MAX_CONN_IDLE_TIME=30m

# How often to poll getEvents (minimum 1s).
POLL_INTERVAL=5s

# API + dashboard listen address (host:port; empty host means all interfaces).
HTTP_ADDR=:8080

# Maximum request body size for API write endpoints (POST/PATCH/PUT), in
# bytes. Default 1 MiB is large enough for nested rule params and small
# enough to bound unauthenticated writes. GET/HEAD/OPTIONS are not limited.
# HTTP_MAX_BODY_BYTES=1048576

# debug | info | warn | error
LOG_LEVEL=info

# Ledger lag at which /readyz fails. Unset or 0 disables the check so
# existing probes cannot start failing without opting in.
# READYZ_LAG_THRESHOLD=0
# How long to keep alerts (and cascaded delivery_attempts). Unset keeps
# history forever. Examples: 90d, 24h. Deletes run in batches of 1000.
# ALERT_RETENTION=90d

# --- Network -------------------------------------------------------------
# Which Stellar network to monitor. A network's passphrase is its identity:
# SoroBeacon verifies at startup that the RPC endpoint belongs to the
# configured network and refuses to start on a mismatch, so a mainnet
# endpoint behind testnet configuration fails fast instead of silently
# evaluating rules against the wrong chain.
#   testnet    (default) SDF public testnet
#   mainnet    SDF public mainnet
#   futurenet  SDF futurenet
#   custom     private network: RPC_URL and NETWORK_PASSPHRASE required
NETWORK=testnet
# Override the RPC endpoint for any network (e.g. a provider URL for
# mainnet, or a local quickstart node).
# RPC_URL=https://soroban-testnet.stellar.org
# Override the passphrase (e.g. a local standalone quickstart network).
# NETWORK_PASSPHRASE=Standalone Network ; February 7th 1974 at 8:37:19 PM

# --- Observability --------------------------------------------------------
# Prometheus metrics are served on /metrics (no configuration needed).

# --- Event source --------------------------------------------------------
# Where events come from.
#   rpc        (default) poll a Stellar RPC node directly (standalone)
#   sorotrail  read from a SoroTrail indexer's HTTP API (upstream)
# Upstream mode monitors through an indexer that stores events durably,
# past the RPC's ~1-7 day retention window, and lets several SoroBeacon
# instances share one indexer.
SOURCE_MODE=rpc
# Base URL of a SoroTrail indexer. Required when SOURCE_MODE=sorotrail.
# SOROTRAIL_URL=http://localhost:8080

# --- CORS --------------------------------------------------------------------
# Comma-separated allow-list of browser Origins that may call the API
# cross-origin. Empty (default) disables CORS — the dashboard is same-origin.
# Think hard before allowing a third-party origin: the API is unauthenticated
# and mutates monitors and channels.
# CORS_ALLOWED_ORIGINS=https://ops.example

# --- API rate limiting -------------------------------------------------------
# Per-client token bucket on /api/v1. Unset / 0 leaves the limiter off so
# existing probes and scripts are unaffected. Health, livez and readyz are
# always exempt. Client identity is RemoteAddr unless TRUST_FORWARDED is on
# (only enable that behind a proxy that overwrites X-Forwarded-For).
# RATE_LIMIT_RPS=10
# RATE_LIMIT_BURST=20
# RATE_LIMIT_TRUST_FORWARDED=false
