# Stellar RPC endpoint (JSON-RPC 2.0). Default is testnet; point at a
# mainnet RPC for production.
RPC_URL=https://soroban-testnet.stellar.org

# Postgres connection string (required).
DATABASE_URL=postgres://sorobeacon:sorobeacon@localhost:5432/sorobeacon?sslmode=disable

# How often to poll getEvents (minimum 1s).
POLL_INTERVAL=5s

# API + dashboard listen address.
HTTP_ADDR=:8080

# debug | info | warn | error
LOG_LEVEL=info

# --- Network -------------------------------------------------------------
# Which Stellar network to monitor. A network's passphrase is its identity:
# SoroBeacon verifies at startup that the RPC endpoint belongs to the
# configured network and refuses to start on a mismatch, so a mainnet
# endpoint behind testnet configuration fails fast instead of silently
# evaluating rules against the wrong chain.
#   testnet    (default) SDF public testnet
#   mainnet    SDF public mainnet
#   futurenet  SDF futurenet
#   custom     private network: RPC_URL and NETWORK_PASSPHRASE required
NETWORK=testnet
# Override the RPC endpoint for any network (e.g. a provider URL for
# mainnet, or a local quickstart node).
# RPC_URL=https://soroban-testnet.stellar.org
# Override the passphrase (e.g. a local standalone quickstart network).
# NETWORK_PASSPHRASE=Standalone Network ; February 7th 1974 at 8:37:19 PM
