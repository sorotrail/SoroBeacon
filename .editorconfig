root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# gofmt always uses tabs; let it own Go indentation rather than fighting it.
[*.go]
indent_style = tab

[*.{yml,yaml,md}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
